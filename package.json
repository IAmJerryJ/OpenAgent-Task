{
  "name": "openagent-task",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "npm install --prefix server",
    "install:client": "npm install --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:seed": "concurrently \"npm run dev:server:seed\" \"npm run dev:client\"",
    "dev:reset": "concurrently \"npm run dev:server:reset\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:server:seed": "cd server && npm run dev:seed",
    "dev:server:reset": "cd server && npm run dev:reset",
    "dev:client": "cd client && npm run dev",
    "build": "concurrently \"npm run build:server\" \"npm run build:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm run preview",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "format": "npm run format:server && npm run format:client",
    "format:server": "npm run format --prefix server",
    "format:client": "npm run format --prefix client",
    "format:check": "npm run format:check:server && npm run format:check:client",
    "format:check:server": "npm run format:check --prefix server",
    "format:check:client": "npm run format:check --prefix client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --prefix server",
    "lint:client": "npm run lint --prefix client",
    "lint:fix": "npm run lint:fix:server && npm run lint:fix:client",
    "lint:fix:server": "npm run lint:fix --prefix server",
    "lint:fix:client": "npm run lint:fix --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAmJerryJ/OpenAgent-Task.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IAmJerryJ/OpenAgent-Task/issues"
  },
  "homepage": "https://github.com/IAmJerryJ/OpenAgent-Task#readme",
  "description": ""
}
